{
  "name": "@lor-looma/core",
  "version": "0.2.0",
  "description": "Looma document model, validation, commands and undo/redo. No UI dependencies.",
  "license": "MIT",
  "author": "lor-looma contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lor-looma/looma.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lor-looma/looma/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/lor-looma/looma/issues"
  },
  "keywords": [
    "looma",
    "document",
    "schema",
    "presentation",
    "undo",
    "editor"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "source": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "immer": "^11.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
