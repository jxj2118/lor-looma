{
  "name": "@lor-looma/core",
  "version": "0.0.0",
  "description": "Looma document model, validation, commands and undo/redo. No UI dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "source": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "immer": "^11.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
