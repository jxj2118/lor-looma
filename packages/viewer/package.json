{
  "name": "@lor-looma/viewer",
  "version": "0.2.0",
  "description": "React component for rendering and presenting Looma documents.",
  "license": "MIT",
  "author": "lor-looma contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lor-looma/looma.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/lor-looma/looma/tree/main/packages/viewer#readme",
  "bugs": {
    "url": "https://github.com/lor-looma/looma/issues"
  },
  "keywords": [
    "looma",
    "react",
    "presentation",
    "viewer",
    "slides"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lor-looma/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
